{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "rower",
  "main": "src/server/index.ts",
  "compatibility_date": "2026-09-08",
  "compatibility_flags": ["enable_request_signal", "global_fetch_strictly_public"],
  "workers_dev": true,
  "secrets": { "required": [] },
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "observability": { "enabled": true },
  "ratelimits": [
    { "name": "MODELS_LIMITER", "namespace_id": "1001", "simple": { "limit": 10, "period": 60 } },
    { "name": "EXECUTE_LIMITER", "namespace_id": "1002", "simple": { "limit": 30, "period": 60 } }
  ],
  "env": {
    "staging": {
      "name": "rower-staging",
      "secrets": { "required": [] },
      "ratelimits": [
        { "name": "MODELS_LIMITER", "namespace_id": "1003", "simple": { "limit": 10, "period": 60 } },
        { "name": "EXECUTE_LIMITER", "namespace_id": "1004", "simple": { "limit": 30, "period": 60 } }
      ]
    }
  }
}
